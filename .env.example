PORT=3000

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Google service-account credentials. Store private-key newlines as literal \n sequences.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
GOOGLE_CALENDAR_ID=

# Telegram bot credentials for owner notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vapi sends this Bearer token and trusted call identity to the voice endpoint.
VAPI_SERVER_TOKEN=
VAPI_PHONE_NUMBER=
VAPI_BUSINESS_ID=maple-street-dog-grooming

# LiveKit Cloud voice demo. The backend joins rooms directly from the same Node.js
# process as the HTTP server; no separate worker token is required.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=maple-street-receptionist
