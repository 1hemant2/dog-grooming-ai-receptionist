PORT=3000

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google service account credentials. Use literal \\n
# sequences inside GOOGLE_PRIVATE_KEY when storing it in a single env value.
GOOGLE_CALENDAR_ID=
GOOGLE_SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
