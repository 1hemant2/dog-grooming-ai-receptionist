{
	"name": "maple-street-receptionist",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node --env-file=.env dist/main.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "node --import tsx --test",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/express": "5.0.6",
		"@types/luxon": "3.7.5",
		"@types/node": "26.5.0",
		"eslint": "10.10.0",
		"prettier": "3.9.6",
		"tsx": "4.23.13",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0"
	},
	"dependencies": {
		"@google/genai": "2.21.0",
		"@livekit/agents": "1.8.1",
		"@livekit/rtc-node": "0.13.35",
		"express": "5.2.1",
		"googleapis": "178.1.1",
		"livekit-client": "2.22.3",
		"livekit-server-sdk": "2.19.0",
		"luxon": "3.7.2",
		"zod": "4.6.2"
	}
}
